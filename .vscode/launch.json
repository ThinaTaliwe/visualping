{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run API (uvicorn)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "env": {
        "FXBOT_VISUALPING_WEBHOOK_TOKEN": "change-me"
      },
      "justMyCode": true
    }
  ]
}
